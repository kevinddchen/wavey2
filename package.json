{
  "scripts": {
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "",
    "eslint": "",
    "globals": "",
